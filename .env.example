# Скопируй в .env и заполни. Настоящий .env в git не попадает (см. .gitignore).

# --- Discord OAuth (обязательно: вход только через Discord) ---
# https://discord.com/developers/applications → OAuth2
# В Redirects добавь оба адреса:
#   http://localhost:8080/oauth/callback   — для локальной разработки
#   https://discord.djaploy.dev/oauth/callback — для прода
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Прод, вариант А: mess один на сервере, порты 80/443 свободны ---
# Сам получит сертификат Let's Encrypt.
#DOMAIN=discord.djaploy.dev

# --- Прод, вариант Б: на сервере уже есть nginx/caddy ---
# DOMAIN не задаём, слушаем внутренний порт, TLS терминирует прокси.
#ADDR=:8091
#BASE_URL=https://discord.djaploy.dev

# Публичный IP сервера — нужен WebRTC, чтобы раздать правильные ICE-кандидаты.
#PUBLIC_IP=

# Порт для медиа (UDP+TCP), открыть в файрволе напрямую.
#MEDIA_PORT=8443

# Прочее
#DATA_DIR=data
#MAX_UPLOAD_MB=15
#SESSION_SECRET=          # если пусто — сгенерится и ляжет в DATA_DIR/session.key
#ALLOW_GUESTS=false       # вход без Discord; по умолчанию выключен
